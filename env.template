# Email Configuration (EmailJS)
NEXT_PUBLIC_EMAILJS_SERVICE_ID=your_service_id
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=your_template_id
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=your_public_key

# Outscraper API (for Google Reviews)
OUTSCRAPER_API_KEY=your_outscraper_api_key

# Cron Job Secret (for automated monthly review updates)
# Generate a random string: openssl rand -base64 32
CRON_SECRET=your-cron-secret-here

# CMS Admin Panel
CMS_SECRET=your-random-secret-here
CMS_URL_HASH=your-url-hash-here
CMS_PASSWORD_HASH=your-bcrypt-hashed-password

# Vercel Blob Storage (optional for local dev, required for production)
# In production, Vercel automatically provides this when you connect Blob Storage
# Leave empty for local development (will use local file system)
BLOB_READ_WRITE_TOKEN=
